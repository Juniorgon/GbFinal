# GB & N.Comin Advocacia — Environment Variables
# Copy this file to .env (development) or .env.prod (production)

# Django
DEBUG=True
SECRET_KEY=change-this-to-a-random-50-char-string-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
SYSTEM_VERSION=1.1.0-dev
SYSTEM_ENV=development

# Database
DB_NAME=advocacia_db
DB_USER=advocacia_user
DB_PASSWORD=advocacia_pass123
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=changeme

# Email (use real SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Timezone
TIME_ZONE=America/Sao_Paulo

# Production only
SECURE_SSL_REDIRECT=False
